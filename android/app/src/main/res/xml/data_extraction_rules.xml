<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ cloud backup -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude cache DB and DataStore (may contain API keys) -->
        <exclude domain="database" path="crawl4ai_cache.db" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="crawl4ai_cache.db" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
